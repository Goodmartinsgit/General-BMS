DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PORT=5000
JWT_SECRET=generate_a_strong_random_secret_at_least_64_chars
REFRESH_TOKEN_SECRET=generate_a_different_strong_secret_at_least_64_chars
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3006

# Cloudinary - Media storage
# Get these from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Online Store - Storefront customer authentication (separate from admin JWT)
STORE_JWT_SECRET=generate_a_separate_strong_secret_for_customer_tokens
STORE_FRONTEND_URL=http://localhost:3006

# Paystack - Payment gateway
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
