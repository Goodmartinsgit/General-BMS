# ─── Core ────────────────────────────────────────────────────────────────────
# Get DATABASE_URL from Neon console → Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Render sets PORT automatically; leave as 5000 for local dev
PORT=5000
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_strong_random_secret_at_least_64_chars
REFRESH_TOKEN_SECRET=generate_a_different_strong_secret_at_least_64_chars
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Two separate frontends connect to this backend:
#   1. General BMS Admin (React/Vite) — deployed on Vercel, dev port 5173
#   2. Store Storefront (React/Vite)  — deployed on Vercel, dev port 3006
# Production: comma-separated, no spaces, no trailing slashes
#   e.g. https://general-bms.vercel.app,https://general-bms-store.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3006

# Cloudinary - Media storage
# Get these from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Online Store ─────────────────────────────────────────────────────────────
# Storefront customer authentication (separate from admin JWT)
STORE_JWT_SECRET=generate_a_separate_strong_secret_for_customer_tokens
# Production: your Vercel Store frontend URL (used for CORS + password-reset links)
#   e.g. https://general-bms-store.vercel.app
STORE_FRONTEND_URL=http://localhost:3006

# Paystack - Payment gateway
# Get from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
